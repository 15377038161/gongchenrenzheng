{
  "name": "projects",
  "version": "1.0.0",
  "description": "React + TypeScript application with Express + Vite (React + CSS + TS + Node API)",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "lint:build": "eslint . --quiet",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "test": "pnpm run --parallel \"/^(lint|ts-check)$/\" && pnpm test:account-channel",
    "test:account-channel": "tsx --test tests/chaoxing-account-channel.test.ts",
    "validate": "pnpm run --parallel \"/^(ts-check|lint:build)$/\" && pnpm test:account-channel"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "coder-coding-dev-sdk": "https://robot.chaoxing.com/coder-sdk/coder-coding-dev-sdk.tgz",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "marked": "^18.0.12",
    "multer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/marked": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "only-allow": "^1.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "^7.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.27.2",
      "is-generator-function": "1.0.10"
    }
  }
}
